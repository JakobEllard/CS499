const formatSKU = (sku) => sku.trim().toUpperCase(); //1

//product object literal
const product = {
  name: "wireless mouse",
  price: 29.99,
  get priceTag() {//2
    return "$" + this.price.toFixed(2);
  },
};

// 3
const warehouseLocations = new Map();
warehouseLocations.set(101, "Electronics");
warehouseLocations.set(102, "Apparel");

// 4
function verifyStock(skuInput, aisleNumber) {
  if (!skuInput) {
    throw new Error("sku cannot be empty");
  }

  console.log("Checking SKU: " + formatSKU(skuInput));

  if (warehouseLocations.has(aisleNumber)) {
    console.log("ailse found: " + warehouseLocations.get(aisleNumber));
  } else {
    console.log("unassigned aisle");
  }
}


//tests
try {
  
  verifyStock(" sku-101 ", 101);
  verifyStock(" sku-202 ", 999);
  verifyStock("", 101);

} catch (error) {
  console.log("Error caught: " + error.message);
}